# Copy this file to .env for local/VPS use.
# NEVER upload or commit .env. PJA Host only shows whether a secret exists.

DISCORD_TOKEN=PASTE_A_NEW_DISCORD_BOT_TOKEN_HERE
PJA_API_SECRET=MAKE_A_LONG_RANDOM_SECRET_HERE
PJA_MANAGER_USERNAME=manager
PJA_MANAGER_PASSWORD=MAKE_A_STRONG_MANAGER_PASSWORD_HERE
PJA_MANAGER_SESSION_SECRET=MAKE_A_DIFFERENT_LONG_RANDOM_SECRET_HERE
PJA_MANAGER_SESSION_TTL_SECONDS=28800

# PJA app
PORT=8000
PJA_API_URL=http://127.0.0.1:8000
PJA_WS_URL=ws://127.0.0.1:8000/ws

# Portable persistent storage. Leave blank/commented to use ./data.
# PJA_DATA_DIR=/absolute/path/to/pja/data

# PJA Host
PJA_HOST_AUTOSTART=1
PJA_HOST_AUTO_RESTART=1
PJA_HOST_RESTART_DELAY_SECONDS=5
PJA_HOST_MAX_CRASHES=5
PJA_HOST_CRASH_WINDOW_SECONDS=600
PJA_HOST_BACKUP_INTERVAL_SECONDS=21600
PJA_HOST_BACKUP_KEEP=30
# PJA_BACKUP_DIR=/absolute/path/to/pja/backups
